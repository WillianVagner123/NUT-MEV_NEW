{
  "version": "1.2",
  "scope": "search_and_evidence_sources",
  "authority": "Canonical search/evidence-source registry. LLM/local-model capabilities live in provider_registry.json and are intentionally excluded here.",
  "providers": {
    "pubmed": {
      "provider_registry_id": "ncbi_pubmed",
      "type": "biomedical_index",
      "priority": 1,
      "default_enabled": true,
      "method_track": "indexed_database"
    },
    "europepmc": {
      "provider_registry_id": "europepmc",
      "type": "biomedical_index",
      "priority": 2,
      "default_enabled": true,
      "method_track": "indexed_database"
    },
    "openalex": {
      "provider_registry_id": "openalex",
      "type": "scholarly_index",
      "priority": 3,
      "default_enabled": true,
      "method_track": "indexed_database"
    },
    "crossref": {
      "provider_registry_id": "crossref",
      "type": "doi_index",
      "priority": 4,
      "default_enabled": true,
      "method_track": "indexed_database"
    },
    "official_web": {
      "provider_registry_id": "official_web",
      "type": "official_sources",
      "priority": 5,
      "default_enabled": true,
      "method_track": "official_institutional"
    },
    "scielo_native": {
      "provider_registry_id": "scielo_native",
      "type": "native_official_export",
      "priority": 6,
      "default_enabled": false,
      "method_track": "regional_index_native",
      "coverage_note": "Native SciELO route: exact platform query plus official CSV/RIS export and SHA-256. Enabled only when a versioned strategy explicitly includes it."
    },
    "lilacs_bvs": {
      "provider_registry_id": "lilacs_bvs",
      "type": "native_official_export",
      "priority": 7,
      "default_enabled": false,
      "method_track": "regional_index_native",
      "coverage_note": "Native LILACS/BVS route: exact platform query plus official CSV/RIS export and SHA-256. Enabled only when a versioned strategy explicitly includes it."
    },
    "doaj": {
      "provider_registry_id": "doaj",
      "type": "bibliographic_index",
      "priority": 8,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "clinicaltrials": {
      "provider_registry_id": "clinicaltrials",
      "type": "trial_registry",
      "priority": 9,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "scielo": {
      "provider_registry_id": "scielo",
      "type": "crossref_prefix_connector",
      "priority": 10,
      "default_enabled": false,
      "method_track": "supplementary_discovery",
      "coverage_note": "Compatibility/proxy route: Crossref retrieval restricted to DOI prefix 10.1590; never represented as a native comprehensive SciELO platform search."
    },
    "semantic_scholar": {
      "provider_registry_id": "semantic_scholar",
      "type": "scholarly_index",
      "priority": 11,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "arxiv": {
      "provider_registry_id": "arxiv",
      "type": "preprint_index",
      "priority": 12,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "google_pse": {
      "provider_registry_id": "google_pse",
      "type": "web_search",
      "priority": 20,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "serpapi": {
      "provider_registry_id": "serpapi",
      "type": "web_search",
      "priority": 21,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    },
    "brave": {
      "provider_registry_id": "brave_search",
      "type": "web_search",
      "priority": 22,
      "default_enabled": false,
      "method_track": "supplementary_discovery"
    }
  },
  "compatibility": {
    "legacy_source_priority_supported": true,
    "fallback_to_default_priority": true,
    "provider_registry_crosswalk_required": true,
    "proxy_never_counts_as_native_scielo": true
  }
}
