{
  "version": "2.0",
  "description": "Canonical semantic evidence lenses for current NutEV analytical outputs. Historical busca* labels are import aliases only.",
  "lenses": {
    "policy_systems": {
      "focus": "policy_systems",
      "domains": ["policy_systems", "dietary_patterns", "equity"]
    },
    "clinical_outcomes": {
      "focus": "clinical_outcomes",
      "domains": ["clinical_outcomes", "dietary_patterns", "policy_systems"]
    },
    "implementation": {
      "focus": "implementation",
      "domains": ["implementation", "clinical_outcomes", "dietary_patterns"]
    },
    "framework": {
      "focus": "framework",
      "domains": ["implementation", "policy_systems", "dietary_patterns"]
    }
  },
  "cross_lens": {
    "shared_outcomes": true,
    "shared_domains": true,
    "allow_multi_label": true
  }
}
