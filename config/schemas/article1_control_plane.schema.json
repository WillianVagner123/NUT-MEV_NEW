{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutev.local/schemas/article1_control_plane.schema.json",
  "title": "NutEV Article 1 deterministic control-plane snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "search_type",
    "prisma_eligible",
    "formal_execution_authorized",
    "freeze_authorized",
    "human_validated",
    "human_decision",
    "blockers"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "stage": {
      "type": "string",
      "enum": [
        "GF02_PUBMED_PILOT",
        "GF02_NOISE_REVIEW",
        "GF02_HUMAN_DECISION",
        "GF03_PRESS",
        "POST_PRESS_PROVIDER_VALIDATION",
        "CLOSE_SCIENTIFIC_GATES",
        "FREEZE",
        "FORMAL_EXECUTION",
        "SCREENING_INITIALIZATION",
        "SCREENING_REVIEWER_ASSIGNMENT",
        "TITLE_ABSTRACT_HUMAN_REVIEW",
        "SCREENING_HUMAN_REVIEW",
        "FULLTEXT_HUMAN_REVIEW",
        "ABCD_HUMAN_REVIEW",
        "RELATIONS_HUMAN_REVIEW",
        "ADJUDICATION",
        "SYNTHESIS_PRISMA",
        "COMPLETE"
      ]
    },
    "search_type": {"type": "string", "enum": ["PILOT", "FORMAL"]},
    "prisma_eligible": {"type": "boolean"},
    "formal_execution_authorized": {"type": "boolean"},
    "freeze_authorized": {"type": "boolean"},
    "human_validated": {"type": "boolean"},
    "human_decision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "enum": ["READY_FOR_PRESS", "NOT_READY_FOR_PRESS"]}
      ]
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
