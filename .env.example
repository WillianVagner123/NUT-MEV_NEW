# NutEV Reference Engine environment
# Copy to .env only if you need optional provider credentials. Never commit real secrets.

# PubMed / NCBI
NCBI_EMAIL=
ENTREZ_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=nutev_reference_engine

# Provider contact metadata
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Semantic Scholar - optional key
S2_API_KEY=

# Optional web-search providers
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=
SERPAPI_API_KEY=
