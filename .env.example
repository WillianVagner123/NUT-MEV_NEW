# NutEV / NutMEV environment
# Copy to .env and fill only the keys you actually use.
# Keep real secrets out of version control.

# Network
NUTEV_DISABLE_NETWORK=0
NUTEV_SKIP_PUBMED=0

# NCBI / PubMed
# NCBI_EMAIL is recommended by NCBI; ENTREZ_EMAIL is accepted by NutEV as fallback.
NCBI_EMAIL=
ENTREZ_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=nutev_pipeline
NUTEV_PUBMED_BATCH_SIZE=200
NUTEV_PUBMED_FETCH_ABSTRACTS=0

# Crossref
CROSSREF_MAILTO=

# OpenAlex
OPENALEX_MAILTO=

# DOAJ, ClinicalTrials.gov, SciELO and arXiv — no key required. Available via the
# provider registry; add the id ("doaj"/"clinicaltrials"/"scielo"/"arxiv") to a
# workstream's source_priority to run it. SciELO is scoped to Crossref prefix 10.1590.
NUTEV_SKIP_DOAJ=0
NUTEV_SKIP_CLINICALTRIALS=0
NUTEV_SKIP_SCIELO=0
NUTEV_SKIP_ARXIV=0

# Semantic Scholar — key optional (S2_API_KEY raises the shared rate limit).
# Add "semantic_scholar" to a workstream's source_priority to run it.
S2_API_KEY=
NUTEV_SKIP_SEMANTIC_SCHOLAR=0

# Recall depth per REST provider (opt-in). Unset = historical single page
# (reproducible default). Set a bounded cap to paginate for higher recall.
NUTEV_EUROPEPMC_MAX_RESULTS=
NUTEV_CROSSREF_MAX_RESULTS=
NUTEV_OPENALEX_MAX_RESULTS=
NUTEV_DOAJ_MAX_RESULTS=
NUTEV_CLINICALTRIALS_MAX_RESULTS=
NUTEV_SCIELO_MAX_RESULTS=
NUTEV_SEMANTIC_SCHOLAR_MAX_RESULTS=
NUTEV_ARXIV_MAX_RESULTS=

# Optional Google / gray literature
# Google, SerpAPI and Brave are optional and are not required for scientific searches.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# Optional LLM
OPENAI_API_KEY=

# Webhook
NUTEV_DIGEST_WEBHOOK_URL=
NUTEV_NOTIFY_WEBHOOK=0

# OCR backend (extraction of scanned PDFs)
# Default 'tesseract' is deterministic + offline. 'olmocr' is an OPT-IN,
# GPU-bound, non-deterministic backend that requires a user-installed `olmocr`
# (NutEV ships no model weights — review olmOCR's model license yourself). It
# always falls back to Tesseract when unavailable or on error.
NUTEV_OCR_BACKEND=tesseract
NUTEV_SKIP_OLMOCR=0
NUTEV_OLMOCR_TIMEOUT=600

# Debug / limits
NUTEV_LOG_LEVEL=INFO
NUTEV_CAPTURE_LIMIT=
NUTEV_DOWNLOAD_LIMIT=
