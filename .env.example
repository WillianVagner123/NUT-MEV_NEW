# NutEV Reference Engine environment variable reference
#
# IMPORTANT: the current runtime does NOT automatically load this file.
# Use these names in the shell/process environment before running the engine.
# Windows CMD example: set NCBI_EMAIL=you@example.com
# PowerShell example: $env:NCBI_EMAIL="you@example.com"
# Never commit real secrets.

# PubMed / NCBI
NCBI_EMAIL=
ENTREZ_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=nutev_reference_engine

# Provider contact metadata
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Semantic Scholar - optional key
S2_API_KEY=

# Optional web-search providers
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Collection profile
# Default is operational. Set to 1 only for the configured large/deep limits.
NUTEV_DEEP_COLLECTION=
