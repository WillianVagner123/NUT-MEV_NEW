# Public hostname. DNS A/AAAA must point to the Hetzner server.
NUTEV_DOMAIN=nutev.example.com

# Coordinator login used by Caddy Basic Auth.
NUTEV_BASIC_USER=coordinator
# Generate with:
# docker run --rm -it caddy:2-alpine caddy hash-password --algorithm argon2id
# Store the resulting value inside single quotes in .env because the hash contains $.
NUTEV_BASIC_HASH='REPLACE_WITH_CADDY_HASH'

# Internal reverse-proxy secret. Never send this value to users/reviewers.
# Generate with: openssl rand -hex 32
NUTEV_PROXY_COORDINATOR_SECRET=REPLACE_WITH_RANDOM_64_HEX

# Private blinded assessor packet directory on the Hetzner host.
NUTEV_VALIDATION_PACKET_HOST_DIR=/opt/nutev-private/validation_assessor_packets

# PubMed / NCBI
NCBI_EMAIL=
ENTREZ_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=nutev_reference_engine

# Provider contact metadata
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Semantic Scholar optional key
S2_API_KEY=

# Optional web-search providers
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Keep network enabled in production.
NUTEV_DISABLE_NETWORK=0
