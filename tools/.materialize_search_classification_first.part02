 na literatura.')", "search prompt"),
    ("'Iniciando revisão estruturada + Busca global…'", "'Iniciando busca estruturada avançada + busca ampla…'", "opening structured global"),
    ("'Iniciando revisão estruturada…'", "'Iniciando busca estruturada avançada…'", "opening structured"),
    ("'Revisão estruturada · Busca global · '", "'Busca estruturada avançada · busca ampla · '", "job structured global"),
    ("'Revisão estruturada · '", "'Busca estruturada avançada · '", "job structured"),
    ("'<div class=\"review-result-note\"><strong>Revisão estruturada.</strong> Cada fonte recebeu sua própria query compilada; a estratégia está preservada abaixo e no result.json.</div>'", "'<div class=\"review-result-note\"><strong>Busca estruturada avançada.</strong> Cada fonte recebeu sua própria query compilada; a estratégia está preservada abaixo e no result.json.</div>'", "structured summary"),
):
    text = replace_once(text, old, new, f"app.js {label}")
old_card = '''function resultCard(r){const href=r.doi?`https://doi.org/${String(r.doi).replace(/^https?:\\/\\/doi\\.org\\//i,'').replace(/^doi:/i,'')}`:(r.url||'');const id=r.pmid?`PMID ${r.pmid}`:(r.doi?`DOI ${r.doi}`:'');return `<article class="result-card"><div class="result-top"><div class="rank">${esc(r.reference_rank)}</div><div style="flex:1"><h3>${esc(r.title||'(sem título)')}</h3><div class="meta"><span>${esc(r.journal||'—')}</span><span>${esc(r.year||'—')}</span><span>${esc(r.source_provider||r.source||'')}</span><span>${esc(id)}</span></div></div><div class="score"><strong>${Number(r.reference_score||0).toFixed(1)}</strong><span>prioridade</span></div></div>${r.abstract?`<div class="abstract">${esc(r.abstract).slice(0,900)}${String(r.abstract).length>900?'…':''}</div>`:''}${href?`<div class="links"><a href="${esc(href)}" target="_blank" rel="noopener noreferrer">Abrir fonte ↗</a></div>`:''}</article>`}'''
new_card = r'''const CLASS_LABELS={evidence_synthesis:'Síntese de evidência',guidance:'Diretriz / guidance',primary_randomized:'Ensaio randomizado',primary_observational:'Estudo observacional',primary_qualitative:'Estudo qualitativo',review:'Revisão',unclassified:'Não classificado'};
const CONFIDENCE_LABELS={high:'confiança alta',medium:'confiança média',low:'sinal insuficiente'};
function inferredClass(r){const explicit=r.search_classification?.document_class;if(explicit)return explicit;const text=`${r.article_type||''} ${r.document_type_applied||''} ${r.title||''}`.toLocaleLowerCase();if(text.includes('systematic review')||text.includes('meta-analysis')||text.includes('meta analysis'))return'evidence_synthesis';if(text.includes('guideline')||text.includes('consensus statement')||text.includes('position statement'))return'guidance';if(text.includes('randomized')||text.includes('randomised'))return'primary_randomized';if(text.includes('cohort')||text.includes('cross-sectional')||text.includes('case-control'))return'primary_observational';if(text.includes('qualitative'))return'primary_qualitative';if(text.includes('review'))return'review';return'unclassified'}
function taxonomyLabel(value){return String(value||'').split('.').filter(Boolean).slice(-2).join(' › ').replaceAll('_',' ')}
function whyMatched(r){const c=r.search_classification||{};const q=c.query_match||{};const parts=[];if((q.title_hits||[]).length)parts.push(`título: ${(q.title_hits||[]).slice(0,5).join(', ')}`);if((q.abstract_hits||[]).length)parts.push(`resumo: ${(q.abstract_hits||[]).slice(0,5).join(', ')}`);const tax=c.taxonomy_primary||r.taxonomy_primary;if(tax)parts.push(`tema: ${taxonomyLabel(tax)}`);if(r.document_type_applied)parts.push(`sinal documental: ${r.document_type_applied}`);return parts}
function resultCard(r){const href=r.doi?`https://doi.org/${String(r.doi).replace(/^https?:\/\/doi\.org\//i,'').replace(/^doi:/i,'')}`:(r.url||'');const id=r.pmid?`PMID ${r.pmid}`:(r.doi?`DOI ${r.doi}`:'');const c=r.search_classification||{};const klass=inferredClass(r);const confidence=c.confidence||'low';const taxonomy=c.taxonomy_primary||r.taxonomy_primary||'';const reasons=whyMatched(r);const signals=(c.signals||[]).map(x=>`${x.field}: ${x.value}`);return `<article class="result-card"><div class="result-top"><div class="rank">${esc(r.reference_rank)}</div><div style="flex:1"><h3>${esc(r.title||'(sem título)')}</h3><div class="meta"><span>${esc(r.journal||'—')}</span><span>${esc(r.year||'—')}</span><span>${esc(r.source_provider||r.source||'')}</span><span>${esc(id)}</span></div></div><div class="score"><strong>${Number(r.reference_score||0).toFixed(1)}</strong><span>ranking NutEV</span></div></div><div class="classification-row"><span class="class-pill">${esc(CLASS_LABELS[klass]||klass)}</span><span class="confidence-pill">${esc(CONFIDENCE_LABELS[confidence||confidence)}</span>${taxonomy?`<span class="taxonomy-pill">${esc(taxonomyLabel(taxonomy))}</span>`:''}</div></div><div class="score">