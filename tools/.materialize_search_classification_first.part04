 library/classification explorer.
path = WEB / "articles.html"
text = read(path)
for old, new, label in (
    ("<title>Corpus Explorer — NutEV Evidence Engine</title>", "<title>Biblioteca de Artigos — NutEV Evidence Engine</title>", "title"),
    ("<meta name=\"description\" content=\"Corpus Explorer paginado do NutEV, com filtros server-side, dossiê e proveniência científica.\">", "<meta name=\"description\" content=\"Biblioteca pesquisável do NutEV com classificação automática, filtros, ranking e dossiê científico.\">", "description"),
    ("<div class=\"sidebar-note\">O Corpus Explorer carrega páginas filtradas. Tiers, perfis, trechos e rotas são auxiliares operacionais, não conclusões científicas aceitas.</div>", "<div class=\"sidebar-note\">A Biblioteca organiza artigos por classe, tema, fonte, ranking e disponibilidade de texto. Classificações são auxiliares de indexação rastreáveis.</div>", "note"),
    ("<header class=\"topbar\"><div><h1>Corpus Explorer</h1><p>Explore o banco em escala, filtre o corpus e abra o Scientific Dossier sem carregar todos os registros no navegador.</p></div><span class=\"status-pill\" id=\"articleHealth\">verificando banco…</span></header>", "<header class=\"topbar\"><div><h1>Biblioteca de Artigos</h1><p>Explore o banco NutEV por classificação, tema, fonte, prioridade de leitura e disponibilidade de texto.</p></div><span class=\"status-pill\" id=\"articleHealth\">verificando banco…</span></header>", "header"),
    ("<label>Tipo documental<select id=\"classFilter\">", "<label>Classificação do artigo<select id=\"classFilter\">", "class filter"),
    ("<span> artigos no filtro atual</span>", "<span> artigos na seleção atual</span>", "summary"),
):
    text = replace_once(text, old, new, f"articles {label}")
write(path, text)

# Preserve current scientific dashboard, then replace product home.
old_index = read(WEB / "index.html")
legacy = old_index.replace("<title>NutEV — Scientific Overview</title>", "<title>NutEV — Painel científico avançado</title>", 1)
legacy = legacy.replace("<h1>Scientific Overview</h1>", "<h1>Painel científico avançado</h1>", 1)
write(WEB / "scientific-dashboard.html", legacy)

