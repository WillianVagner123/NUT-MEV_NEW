}</span><span>${esc(id)}</span></div><div class="classification-row"><span class="class-pill">${esc(CLASS_LABELS[klass]||klass)}</span><span class="confidence-pill">${esc(CONFIDENCE_LABELS[confidence]||confidence)}</span>${taxonomy?`<span class="taxonomy-pill">${esc(taxonomyLabel(taxonomy))}</span>`:''}</div></div><div class="score"><strong>${Number(r.reference_score||0).toFixed(1)}</strong><span>ranking NutEV</span></div></div>${reasons.length?`<div class="why-match"><strong>Por que apareceu</strong><span>${reasons.map(esc).join(' · ')}</span></div>`:''}${signals.length?`<div class="result-signals"><strong>Base da classificação:</strong> ${signals.map(esc).join(' · ')}</div>`:''}${r.abstract?`<div class="abstract">${esc(r.abstract).slice(0,900)}${String(r.abstract).length>900?'…':''}</div>`:''}${href?`<div class="links"><a href="${esc(href)}" target="_blank" rel="noopener noreferrer">Abrir fonte ↗</a></div>`:''}</article>`}'''
text = replace_once(text, old_card, new_card, "app.js result card")
write(path, text)

# Styles for classification/search-first home/advanced shelf.
path = WEB / "styles.css"
text = read(path)
marker = "/* search-classification-first-v1 */"
if marker in text:
    raise RuntimeError("styles marker already present")
text += r'''
/* search-classification-first-v1 */
.classification-row{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.5rem}.class-pill,.confidence-pill,.taxonomy-pill{display:inline-flex;align-items:center;border-radius:999px;padding:.28rem .55rem;font-size:.72rem;font-weight:750}.class-pill{background:#e8f7f2;color:#0b665b;border:1px solid #b8ddd3}.confidence-pill{background:#f4f6f5;color:#52645f;border:1px solid var(--line)}.taxonomy-pill{background:#f8f4eb;color:#735b1c;border:1px solid #eadcb6}.why-match{display:flex;gap:.5rem;align-items:flex-start;flex-wrap:wrap;margin-top:.7rem;padding:.6rem .7rem;border-radius:10px;background:#f6faf9;color:#4c625d;font-size:.78rem}.why-match strong{color:#244941}.result-signals{margin-top:.45rem;color:#667572;font-size:.72rem;line-height:1.45}.home-main{max-width:1260px}.home-hero{padding:2rem;margin-bottom:1rem;background:linear-gradient(135deg,#ffffff,#eef8f5)}.home-eyebrow{font-size:.76rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;color:var(--green)}.home-hero h2{font-size:2rem;max-width:780px;margin:.45rem 0}.home-hero p{color:var(--muted);max-width:780px;line-height:1.6}.home-search{display:flex;gap:.6rem;margin-top:1rem}.home-search input{flex:1;min-width:0;border:1px solid #b8cdc7;border-radius:12px;padding:.85rem 1rem;font:inherit}.home-search button{white-space:nowrap}.home-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;margin:1rem 0}.home-action{text-decoration:none;color:inherit;transition:transform .15s ease,border-color .15s ease}.home-action:hover{transform:translateY(-2px);border-color:#9bcac0}.home-action strong{display:block;margin-bottom:.3rem}.home-action span{color:var(--muted);font-size:.82rem;line-height:1.45}.classification-contract{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin-top:.8rem}.classification-contract div{padding:.8rem;border:1px solid var(--line);border-radius:12px;background:#fbfdfc}.classification-contract strong{display:block;font-size:.8rem;margin-bottom:.2rem}.classification-contract span{font-size:.78rem;color:var(--muted);line-height:1.4}.hibernate-note{display:flex;justify-content:space-between;gap:1rem;align-items:center}.hibernate-note p{margin:.3rem 0 0;color:var(--muted);font-size:.85rem}.advanced-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.advanced-card h2{margin-top:0}.hibernated-badge{display:inline-flex;border-radius:999px;background:#f2f4f3;color:#61706d;border:1px solid var(--line);padding:.24rem .5rem;font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.advanced-links{display:grid;gap:.45rem;margin-top:.8rem}.advanced-links a{text-decoration:none;color:var(--green);font-weight:700;font-size:.85rem}.advanced-card p{color:var(--muted);font-size:.84rem;line-height:1.5}@media(max-width:1000px){.home-grid{grid-template-columns:1fr 1fr}.classification-contract{grid-template-columns:1fr 1fr}}@media(max-width:650px){.home-grid,.classification-contract,.advanced-grid{grid-template-columns:1fr}.home-search{display:grid}.home-hero{padding:1.2rem}.home-hero h2{font-size:1.55rem}.hibernate-note{display:block}}
'''
write(path, text)

# Corpus becomes the article